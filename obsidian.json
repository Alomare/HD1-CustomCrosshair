{
  "obsidian": 1,
  "id": "alomare.customcrosshair",
  "version": "0.3.1",
  "name": {
    "en": "Custom Crosshair"
  },
  "description": {
    "en": "Replaces the aim cursor with a crosshair built from shapes, one look between shots and one while aiming: shape, scale, gap, thickness, color, opacity, outline and a shadow that can be soft, with a live preview. A hitmarker flashes at the crosshair on hits and kills. Works in the top-down view and with Integrated Third Person."
  },
  "authors": [
    "Alomare"
  ],
  "scope": "client",
  "entry": "main.lua",
  "source": "https://github.com/Alomare/HD1-CustomCrosshair",
  "modules": [
    "src/shapes.lua",
    "src/hitmarker.lua"
  ],
  "requires": [
    "obsidian.api"
  ],
  "loader_api": 1,
  "option_groups": [
    { "id": "general", "label": { "en": "General" } },
    { "id": "idle", "label": { "en": "Idle" },
      "description": { "en": "Between shots. The game shows a cursor here only while the crosshair option in the game settings keeps the crosshair visible; otherwise the cursor hides between shots." } },
    { "id": "aim", "label": { "en": "Aiming" },
      "description": { "en": "While the aim button, fire or a throw is held." } },
    { "id": "hitmarker", "label": { "en": "Hitmarker" },
      "description": { "en": "Lines that flash around the crosshair when a shot from this player hurts or kills an enemy, then fade out. Hits from teammates never show. The hits come from Obsidian API, which switches on with Custom Crosshair." } }
  ],
  "option_previews": [
    { "id": "idle_preview", "group": "idle", "template": "preview/idle.svg", "width": 240, "height": 140,
      "label": { "en": "Idle crosshair" } },
    { "id": "aim_preview", "group": "aim", "template": "preview/aim.svg", "width": 240, "height": 140,
      "label": { "en": "Aiming crosshair" } },
    { "id": "hitmarker_preview", "group": "hitmarker", "template": "preview/hitmarker.svg", "width": 240, "height": 140,
      "label": { "en": "Hit and kill marks" } }
  ],
  "options": [
    { "id": "enabled", "type": "toggle", "default": true, "group": "general",
      "label": { "en": "Custom crosshair" },
      "description": { "en": "Draws the crosshair set here in place of the game cursor, in missions and on the ship. The menu cursor stays as it is." } },
    { "id": "third_person", "type": "toggle", "default": true, "group": "general",
      "label": { "en": "Third person crosshair" },
      "description": { "en": "With Integrated Third Person, draws this crosshair where shots go, in place of the one from that mod. The game has no cursor in third person, so a state set to Game cursor uses the default look there." } },

    { "id": "idle_shape", "type": "choice", "default": "circle", "group": "idle",
      "choices": [
        { "id": "cross", "label": { "en": "Cross" } },
        { "id": "cross_dot", "label": { "en": "Cross with dot" } },
        { "id": "dot", "label": { "en": "Dot" } },
        { "id": "circle", "label": { "en": "Circle" } },
        { "id": "circle_dot", "label": { "en": "Circle with dot" } },
        { "id": "circle_cross", "label": { "en": "Circle with cross" } },
        { "id": "t", "label": { "en": "T" } },
        { "id": "chevron", "label": { "en": "Chevron" } },
        { "id": "brackets", "label": { "en": "Brackets" } },
        { "id": "game", "label": { "en": "Game cursor" } },
        { "id": "none", "label": { "en": "None" } }
      ],
      "label": { "en": "Idle shape" },
      "description": { "en": "Game cursor keeps the cursor of the game; None shows no crosshair at all." } },
    { "id": "idle_scale", "type": "number", "default": 1, "min": 0, "max": 4, "step": 0.01, "group": "idle",
      "label": { "en": "Idle scale" },
      "description": { "en": "Size of the whole crosshair, outline and shadow included. At 1 the pixel sizes below are drawn as set." } },
    { "id": "idle_gap", "type": "number", "default": 4, "min": 0, "max": 24, "step": 0.01, "group": "idle",
      "label": { "en": "Idle gap (px)" },
      "description": { "en": "Space between the center and the lines. Also sets how wide circles, brackets and the chevron sit." } },
    { "id": "idle_thickness", "type": "number", "default": 1, "min": 0, "max": 6, "step": 0.01, "group": "idle",
      "label": { "en": "Idle thickness (px)" },
      "description": { "en": "Width of the lines. The dot is twice as wide." } },
    { "id": "idle_color", "type": "color", "default": "#ffffff", "group": "idle",
      "label": { "en": "Idle color" } },
    { "id": "idle_opacity", "type": "number", "default": 0.6, "min": 0, "max": 1, "step": 0.01, "group": "idle",
      "label": { "en": "Idle opacity" },
      "description": { "en": "1 is solid. The outline and the shadow fade with the lines." } },
    { "id": "idle_outline", "type": "toggle", "default": true, "group": "idle",
      "label": { "en": "Idle outline" },
      "description": { "en": "A border around every line, so the crosshair stands out on light and dark ground." } },
    { "id": "idle_outline_color", "type": "color", "default": "#000000", "group": "idle", "visible_when": { "idle_outline": true },
      "label": { "en": "Idle outline color" } },
    { "id": "idle_outline_thickness", "type": "number", "default": 1, "min": 0, "max": 4, "step": 0.01, "group": "idle", "visible_when": { "idle_outline": true },
      "label": { "en": "Idle outline thickness (px)" } },
    { "id": "idle_shadow", "type": "toggle", "default": false, "group": "idle",
      "label": { "en": "Idle shadow" },
      "description": { "en": "A copy behind the crosshair, moved down and to the right." } },
    { "id": "idle_shadow_color", "type": "color", "default": "#000000", "group": "idle", "visible_when": { "idle_shadow": true },
      "label": { "en": "Idle shadow color" } },
    { "id": "idle_shadow_opacity", "type": "number", "default": 0.5, "min": 0, "max": 1, "step": 0.01, "group": "idle", "visible_when": { "idle_shadow": true },
      "label": { "en": "Idle shadow opacity" } },
    { "id": "idle_shadow_offset", "type": "number", "default": 2, "min": 0, "max": 6, "step": 0.01, "group": "idle", "visible_when": { "idle_shadow": true },
      "label": { "en": "Idle shadow offset (px)" },
      "description": { "en": "Distance down and to the right." } },
    { "id": "idle_shadow_size", "type": "number", "default": 1, "min": 0, "max": 2, "step": 0.01, "group": "idle", "visible_when": { "idle_shadow": true },
      "label": { "en": "Idle shadow size" },
      "description": { "en": "Scales the shadow around the center of the crosshair. Below 1 the shadow shrinks inside the lines; above 1 it reaches past them." } },
    { "id": "idle_shadow_spread", "type": "number", "default": 0, "min": 0, "max": 6, "step": 0.01, "group": "idle", "visible_when": { "idle_shadow": true },
      "label": { "en": "Idle shadow spread (px)" },
      "description": { "en": "Widens the shadow by this many pixels on every side, on top of the outline width." } },
    { "id": "idle_shadow_blur", "type": "number", "default": 0, "min": 0, "max": 3, "step": 1, "group": "idle", "visible_when": { "idle_shadow": true },
      "label": { "en": "Idle shadow blur (px)" },
      "description": { "en": "Softens the shadow edge with fainter copies up to this many pixels out. 0 keeps a sharp edge." } },

    { "id": "aim_shape", "type": "choice", "default": "cross_dot", "group": "aim",
      "choices": [
        { "id": "cross", "label": { "en": "Cross" } },
        { "id": "cross_dot", "label": { "en": "Cross with dot" } },
        { "id": "dot", "label": { "en": "Dot" } },
        { "id": "circle", "label": { "en": "Circle" } },
        { "id": "circle_dot", "label": { "en": "Circle with dot" } },
        { "id": "circle_cross", "label": { "en": "Circle with cross" } },
        { "id": "t", "label": { "en": "T" } },
        { "id": "chevron", "label": { "en": "Chevron" } },
        { "id": "brackets", "label": { "en": "Brackets" } },
        { "id": "game", "label": { "en": "Game cursor" } },
        { "id": "none", "label": { "en": "None" } }
      ],
      "label": { "en": "Aiming shape" },
      "description": { "en": "Game cursor keeps the cursor of the game; None shows no crosshair at all." } },
    { "id": "aim_scale", "type": "number", "default": 1, "min": 0, "max": 4, "step": 0.01, "group": "aim",
      "label": { "en": "Aiming scale" },
      "description": { "en": "Size of the whole crosshair, outline and shadow included. At 1 the pixel sizes below are drawn as set." } },
    { "id": "aim_gap", "type": "number", "default": 4, "min": 0, "max": 24, "step": 0.01, "group": "aim",
      "label": { "en": "Aiming gap (px)" },
      "description": { "en": "Space between the center and the lines. Also sets how wide circles, brackets and the chevron sit." } },
    { "id": "aim_gap_spread", "type": "toggle", "default": true, "group": "aim",
      "label": { "en": "Aiming gap scales with spread" },
      "description": { "en": "Opens the aiming gap by up to 12 pixels as the spread of the weapon in hand grows while firing, and closes it as the spread settles." } },
    { "id": "aim_thickness", "type": "number", "default": 2, "min": 0, "max": 6, "step": 0.01, "group": "aim",
      "label": { "en": "Aiming thickness (px)" },
      "description": { "en": "Width of the lines. The dot is twice as wide." } },
    { "id": "aim_color", "type": "color", "default": "#ffffff", "group": "aim",
      "label": { "en": "Aiming color" } },
    { "id": "aim_opacity", "type": "number", "default": 1, "min": 0, "max": 1, "step": 0.01, "group": "aim",
      "label": { "en": "Aiming opacity" },
      "description": { "en": "1 is solid. The outline and the shadow fade with the lines." } },
    { "id": "aim_outline", "type": "toggle", "default": true, "group": "aim",
      "label": { "en": "Aiming outline" },
      "description": { "en": "A border around every line, so the crosshair stands out on light and dark ground." } },
    { "id": "aim_outline_color", "type": "color", "default": "#000000", "group": "aim", "visible_when": { "aim_outline": true },
      "label": { "en": "Aiming outline color" } },
    { "id": "aim_outline_thickness", "type": "number", "default": 1, "min": 0, "max": 4, "step": 0.01, "group": "aim", "visible_when": { "aim_outline": true },
      "label": { "en": "Aiming outline thickness (px)" } },
    { "id": "aim_shadow", "type": "toggle", "default": false, "group": "aim",
      "label": { "en": "Aiming shadow" },
      "description": { "en": "A copy behind the crosshair, moved down and to the right." } },
    { "id": "aim_shadow_color", "type": "color", "default": "#000000", "group": "aim", "visible_when": { "aim_shadow": true },
      "label": { "en": "Aiming shadow color" } },
    { "id": "aim_shadow_opacity", "type": "number", "default": 0.5, "min": 0, "max": 1, "step": 0.01, "group": "aim", "visible_when": { "aim_shadow": true },
      "label": { "en": "Aiming shadow opacity" } },
    { "id": "aim_shadow_offset", "type": "number", "default": 2, "min": 0, "max": 6, "step": 0.01, "group": "aim", "visible_when": { "aim_shadow": true },
      "label": { "en": "Aiming shadow offset (px)" },
      "description": { "en": "Distance down and to the right." } },
    { "id": "aim_shadow_size", "type": "number", "default": 1, "min": 0, "max": 2, "step": 0.01, "group": "aim", "visible_when": { "aim_shadow": true },
      "label": { "en": "Aiming shadow size" },
      "description": { "en": "Scales the shadow around the center of the crosshair. Below 1 the shadow shrinks inside the lines; above 1 it reaches past them." } },
    { "id": "aim_shadow_spread", "type": "number", "default": 0, "min": 0, "max": 6, "step": 0.01, "group": "aim", "visible_when": { "aim_shadow": true },
      "label": { "en": "Aiming shadow spread (px)" },
      "description": { "en": "Widens the shadow by this many pixels on every side, on top of the outline width." } },
    { "id": "aim_shadow_blur", "type": "number", "default": 0, "min": 0, "max": 3, "step": 1, "group": "aim", "visible_when": { "aim_shadow": true },
      "label": { "en": "Aiming shadow blur (px)" },
      "description": { "en": "Softens the shadow edge with fainter copies up to this many pixels out. 0 keeps a sharp edge." } },

    { "id": "hitmarker", "type": "toggle", "default": true, "group": "hitmarker",
      "label": { "en": "Hitmarker" },
      "description": { "en": "Shows four short diagonal lines around the crosshair on a hit, at full strength first, then fading out over the time set below." } },
    { "id": "hitmarker_hits", "type": "toggle", "default": true, "group": "hitmarker", "visible_when": { "hitmarker": true },
      "label": { "en": "Show on hits" },
      "description": { "en": "Every hit that costs an enemy health shows the mark in the hit color." } },
    { "id": "hitmarker_kills", "type": "toggle", "default": true, "group": "hitmarker", "visible_when": { "hitmarker": true },
      "label": { "en": "Show on kills" },
      "description": { "en": "A kill shows the mark in the kill color, over any hit mark still fading." } },
    { "id": "hitmarker_from", "type": "choice", "default": "weapons", "group": "hitmarker", "visible_when": { "hitmarker": true },
      "choices": [
        { "id": "weapons", "label": { "en": "Weapons in hand" } },
        { "id": "all", "label": { "en": "Everything" } }
      ],
      "label": { "en": "Hits from" },
      "description": { "en": "Weapons in hand counts shots from the primary, the sidearm and the support weapon. Rockets, grenades, mines, sentries and stratagems count only with Everything." } },
    { "id": "hitmarker_color", "type": "color", "default": "#ff2d23", "group": "hitmarker", "visible_when": { "hitmarker": true, "hitmarker_hits": true },
      "label": { "en": "Hit color" } },
    { "id": "hitmarker_kill_color", "type": "color", "default": "#ff2d23", "group": "hitmarker", "visible_when": { "hitmarker": true, "hitmarker_kills": true },
      "label": { "en": "Kill color" } },
    { "id": "hitmarker_opacity", "type": "number", "default": 0.6, "min": 0, "max": 1, "step": 0.01, "group": "hitmarker", "visible_when": { "hitmarker": true, "hitmarker_hits": true },
      "label": { "en": "Hit opacity" },
      "description": { "en": "How strong a hit mark shows at first, before the fade. 1 is solid." } },
    { "id": "hitmarker_kill_opacity", "type": "number", "default": 1, "min": 0, "max": 1, "step": 0.01, "group": "hitmarker", "visible_when": { "hitmarker": true, "hitmarker_kills": true },
      "label": { "en": "Kill opacity" },
      "description": { "en": "How strong a kill mark shows at first, before the fade. 1 is solid." } },
    { "id": "hitmarker_kill_scale", "type": "number", "default": 1.5, "min": 0, "max": 2.5, "step": 0.01, "group": "hitmarker", "visible_when": { "hitmarker": true, "hitmarker_kills": true },
      "label": { "en": "Kill mark scale" },
      "description": { "en": "A kill mark is this many times the size of a hit mark: line length, gap and thickness alike." } },
    { "id": "hitmarker_size", "type": "number", "default": 12, "min": 0, "max": 40, "step": 0.01, "group": "hitmarker", "visible_when": { "hitmarker": true },
      "label": { "en": "Hitmarker size (px)" },
      "description": { "en": "Length of each line." } },
    { "id": "hitmarker_gap", "type": "number", "default": 6, "min": 0, "max": 30, "step": 0.01, "group": "hitmarker", "visible_when": { "hitmarker": true },
      "label": { "en": "Hitmarker gap (px)" },
      "description": { "en": "Distance from the center of the crosshair to the inner end of each line, along the diagonal." } },
    { "id": "hitmarker_thickness", "type": "number", "default": 2, "min": 0, "max": 6, "step": 0.01, "group": "hitmarker", "visible_when": { "hitmarker": true },
      "label": { "en": "Hitmarker thickness (px)" },
      "description": { "en": "Width of the lines." } },
    { "id": "hitmarker_time", "type": "number", "default": 0.35, "min": 0, "max": 1.5, "step": 0.01, "group": "hitmarker", "visible_when": { "hitmarker": true },
      "label": { "en": "Hitmarker time (s)" },
      "description": { "en": "How long a mark takes to fade out. A new hit starts the fade again." } },
    { "id": "hitmarker_outline", "type": "toggle", "default": true, "group": "hitmarker", "visible_when": { "hitmarker": true },
      "label": { "en": "Hitmarker outline" },
      "description": { "en": "A black border one pixel wide, so the mark stands out on light ground." } }
  ],
  "resources": []
}
